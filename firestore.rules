rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Development requests submitted by citizens
    match /citizen_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    // High-priority policymaker project recommendations and predictive models
    match /priority_projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Regional indicators & BRICS demographic / infrastructure indices
    match /regional_indices/{indexId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // User profile notes and bookmarks
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
